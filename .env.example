# ==============================================================================
# Siddhi HRMS - Environment Configuration (.env.example)
# Rename to .env on your local deployment server.
# NEVER commit production secrets or real passwords to version control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Application Base URL (for email links, letter generation, and web punch)
APP_URL=http://localhost:3000

# Session & Authentication Secret
SESSION_SECRET=siddhi_super_secret_cryptographic_key_32_chars_min!

# PostgreSQL Database Configuration (Local Server)
POSTGRES_DB=siddhi_hrms
POSTGRES_USER=siddhi_admin
POSTGRES_PASSWORD=YourStrongDatabasePasswordHere!
DATABASE_URL=postgres://siddhi_admin:YourStrongDatabasePasswordHere!@localhost:5432/siddhi_hrms

# Biometric Attendance Realtime Connector Settings
# Note: Configure specific vendor endpoint and credentials in the Admin UI (/biometric)
BIOMETRIC_DEFAULT_POLLING_MINUTES=15
BIOMETRIC_REQUEST_TIMEOUT_SECONDS=30

# File Upload Directory (Local Storage)
UPLOAD_STORAGE_PATH=/app/data/uploads
MAX_UPLOAD_SIZE_MB=25

# Gemini AI API Key (Optional: for automated candidate parsing or report summaries)
GEMINI_API_KEY=MY_GEMINI_API_KEY
